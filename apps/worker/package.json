{
  "name": "@appbuilder/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "spike:snack-check": "tsx --env-file-if-exists=../../.env src/spikes/snack-runtime-check.ts",
    "spike:device": "tsx --env-file-if-exists=../../.env src/spikes/device-preview.ts",
    "spike:generate": "tsx --env-file-if-exists=../../.env src/spikes/generate-screen.ts",
    "eval": "tsx --env-file-if-exists=../../.env src/eval/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@appbuilder/contract": "*",
    "@appbuilder/db": "*",
    "drizzle-orm": "^0.45.4",
    "@appbuilder/core": "*"
  },
  "exports": {
    "./client": "./src/generation/client.ts",
    "./fake-provider": "./src/generation/fake-provider.ts"
  }
}
