# Copy to .env.local (web) / export in your shell (worker). Never commit real values.

# --- Core -------------------------------------------------------------------
DATABASE_URL=postgres://appbuilder:appbuilder@localhost:5432/appbuilder
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Preview runtime origin. Must differ from the app origin (separate port locally,
# separate domain in production) so generated code can never read app cookies.
NEXT_PUBLIC_PREVIEW_ORIGIN=http://localhost:3001

# --- Storage (S3-compatible; MinIO locally) ---------------------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=appbuilder
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# --- LLM (worker only) ------------------------------------------------------
ANTHROPIC_API_KEY=
