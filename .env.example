# Copy to .env at the repo root. It configures the web app, the worker and migrations.
# Never commit real values.

# --- Core -------------------------------------------------------------------
DATABASE_URL=postgres://appbuilder:appbuilder@localhost:5432/appbuilder
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# The app's public origin. Also the OAuth issuer, and the MCP endpoint is $BETTER_AUTH_URL/api/mcp
# (it must be https in production: AI assistants refuse plain http).
BETTER_AUTH_URL=http://localhost:3000
# Encrypts users' GitHub/Expo tokens at rest. Required in production
# (in development it falls back to BETTER_AUTH_SECRET).
ENCRYPTION_KEY=change-me-to-another-long-random-string

# Preview runtime origin. Must differ from the app origin (separate port locally,
# separate domain in production) so generated code can never read app cookies.
NEXT_PUBLIC_PREVIEW_ORIGIN=http://localhost:3001
# Origins allowed to embed the preview (the app's origin).
PREVIEW_ALLOWED_PARENTS=http://localhost:3000
# The app's public URL. Generated apps with App Cloud call this origin, so in production it
# must be reachable from phones (default: the origin of the request).
APP_PUBLIC_URL=
# Local files (uploads without S3, phone-preview projects). Default: ./.data
APP_DATA_DIR=

# --- AI ---------------------------------------------------------------------
# Leave ANTHROPIC_API_KEY empty and set LLM_PROVIDER=fake to run without AI
# (an offline template generator; for demos and tests).
ANTHROPIC_API_KEY=
LLM_PROVIDER=
GENERATION_MODEL=claude-opus-5-5
GENERATION_EFFORT=high
DEFAULT_SCREEN_COUNT=3
# How many screens a build generates at once (each is one streaming model call).
GENERATION_CONCURRENCY=8

# --- Storage (uploads). Unset = local files in .data/storage ------------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI images in generated apps (optional) -----------------------------------
# ImageKit URL endpoint, e.g. https://ik.imagekit.io/your_id. Unset = image placeholders.
# Not for production yet: generations are unsigned, so anyone could use it (docs/05-v1-status.md).
IMAGEKIT_URL_ENDPOINT=

# --- Email (verification and password-reset emails; optional) ------------------
# Unset in production: no verification or reset emails, and "Forgot password" is hidden.
# Sharing still works through invite links. In development, emails print to the log.
RESEND_API_KEY=
EMAIL_FROM=

# --- Sign in with Google / GitHub (optional) ---------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Billing (optional; upgrades are disabled without these) -----------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Monthly prices: Studio (bring your own AI over MCP) and Pro (built-in AI credits).
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_PRO=

# --- On-device preview (worker) ----------------------------------------------
# Hosted (Railway etc.): a wildcard domain routed to the worker, e.g. dev.example.com for
# *.dev.example.com. Each phone session gets a random subdomain on it; the worker accepts them
# on $PORT (default 8090). Takes precedence over the options below.
DEVICE_PREVIEW_DOMAIN=
# No wildcard domain yet: one fixed public host routed to the worker's $PORT (e.g. Railway's
# *.up.railway.app address). Serves one phone preview at a time; a new one ends the last.
DEVICE_PREVIEW_SINGLE_HOST=
# Host or IP phones use to reach the worker's dev servers (default: first LAN IP).
DEVICE_PREVIEW_HOST=
# 1 = expose dev servers through Expo's tunnel (phone on another network).
DEVICE_PREVIEW_TUNNEL=
# Set to 0 on all but one worker (dev servers are local processes).
DEVICE_PREVIEW_ENABLED=1

# --- Hardening ----------------------------------------------------------------
# Server errors are logged as JSON lines; they are also POSTed here when set
# (a Slack/Discord-style incoming webhook or a log collector).
ERROR_WEBHOOK_URL=
# Shared projects need a verified email. Default: on in production. 0 = off, 1 = on.
REQUIRE_VERIFIED_EMAIL=
# Rate limits on sign-in and sign-up. Default: on in production. 0 = off, 1 = on.
AUTH_RATE_LIMIT=
# Where per-IP rate limits read the client's address. Use a header your proxy overwrites
# (x-real-ip, cf-connecting-ip). Default: x-forwarded-for, trusted only with a single value.
CLIENT_IP_HEADER=
# Your proxies' addresses (comma-separated IPs or CIDRs), to read a multi-hop X-Forwarded-For.
TRUSTED_PROXIES=
# Per-user limits on agent runs (plan/build/edit) and new projects.
RATE_LIMIT_RUNS_PER_HOUR=60
RATE_LIMIT_PROJECTS_PER_DAY=20

# Design first (mockups before the build). Worker only. The images are drawn by an image model
# through OpenRouter; without a key the step isn't offered. Claude still goes to Anthropic.
OPENROUTER_API_KEY=
# IMAGE_MODEL=google/gemini-3-pro-image        # the key screen's two options
# DETAIL_IMAGE_MODEL=google/gemini-3.1-flash-image  # cheaper: mascot, other screens, fixes (default IMAGE_MODEL)
# DESIGN_MODEL=claude-opus-5-5            # the visual direction
# DESIGN_REVIEW_MODEL=claude-sonnet-5-5   # rates and checks mockups
# DESIGN_BUILD_MODEL=claude-sonnet-5-5    # builds from approved mockups
# RESEARCH_MODEL=claude-sonnet-5-5        # web research before a first plan (RESEARCH=0: off)
# DESIGN_STEP=0                           # turn the design step off
# Any *_MODEL above (and GENERATION_MODEL) can also be an OpenRouter id such as
# google/gemini-3.8-flash or deepseek/deepseek-v4-flash: those go through OpenRouter's chat
# endpoint with OPENROUTER_API_KEY. A text-only build model builds from the mockups' briefs.
